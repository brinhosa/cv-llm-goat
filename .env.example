# Copy to .env to use a real LLM. Optional — leave blank to use the offline
# mock engine (deterministic, no network, stage-safe).
#
# DeepSeek is OpenAI-compatible. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: tab D (NeMo Guardrails + Jev). Key from https://docs.typesafe.ai
TYPESAFE_API_KEY=
